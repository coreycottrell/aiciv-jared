+def _schedule_paid_vs_seed_reconcile(rail, order_id, session_uuid, human_email='',
+                                     amount='', tier='', grace_seconds=900, is_sandbox=False):
+    """CROSS-CUTTING GUARD: record the paid event, then after a grace window
+    reconcile paid-vs-seeded anchored on the MONEY EVENT. Any paid-but-no-seed
+    -> dead-letter + PORTAL alert on this rail. Fail-safe: the timer is daemonic,
+    so a process exit (no restart) simply drops the pending check (the durable
+    paid_events.jsonl record survives for an out-of-band sweep). Never raises."""
+    if is_sandbox:
+        return
+    _record_paid_event(rail, order_id, session_uuid, human_email, amount, tier)
+
+    def _reconcile():
+        try:
+            if _seed_fired_for(order_id, session_uuid):
+                logger.info(f'[paid-vs-seed] OK: seed fired for {rail} order={order_id} uuid={session_uuid}')
+                return
+            logger.critical(
+                f'[paid-vs-seed] PAID-BUT-NO-SEED on {rail}: order={order_id} uuid={session_uuid} '
+                f'email={human_email} amount={amount}'
+            )
+            _seed_deadletter_and_portal_alert(
+                reason=f'paid_but_no_seed_reconcile_{rail}',
+                portal_summary=(
+                    f'[PAID BUT NO SEED — {rail}] order={order_id or "(none)"} '
+                    f'uuid={session_uuid or "(none)"} email={human_email or "(none)"} '
+                    f'amount={amount}. No seed fired within {grace_seconds}s of the money event. '
+                    f'Manual review + manual seed dispatch. See logs/blocked_seeds.jsonl'
+                ),
+                record={
+                    'rail': rail, 'order_id': order_id, 'session_uuid': session_uuid,
+                    'payer_email': human_email, 'amount': str(amount), 'tier': tier,
+                    'requires_action': 'manual review + manual seed dispatch (money-event reconcile)',
+                },
+                is_sandbox=False,
+            )
+        except Exception as _re:
+            logger.error(f'[paid-vs-seed] reconcile failed for order={order_id}: {_re}')
+
+    try:
+        _t = threading.Timer(grace_seconds, _reconcile)
+        _t.daemon = True
+        _t.start()
+    except Exception as _te:
+        logger.warning(f'[paid-vs-seed] could not schedule reconcile for order={order_id}: {_te}')
+
