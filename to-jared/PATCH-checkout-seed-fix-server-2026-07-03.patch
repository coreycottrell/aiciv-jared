+        _rec['reason'] = reason
+        _rec.setdefault('requires_action', 'manual review + manual seed dispatch')
+        _path = os.path.join(DEFAULT_LOG_DIR, 'blocked_seeds.jsonl')
+        os.makedirs(os.path.dirname(_path), exist_ok=True)
+        with open(_path, 'a') as _f:
+            _f.write(json.dumps(_rec) + '\n')
+    except Exception as _de:
+        logger.error(f'[seed-guard] dead-letter append failed ({reason}): {_de}')
+    try:
+        _sess_file = '/home/jared/projects/AI-CIV/aether/.current_session'
+        try:
+            with open(_sess_file) as _sf:
+                _sess_name = _sf.read().strip()
+        except Exception:
+            _sess_name = 'aether'
+        subprocess.Popen(
+            ['tmux', 'send-keys', '-t', _sess_name, f'\n{portal_summary}\n', 'Enter'],
+            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
+        )
+    except Exception as _pe:
+        logger.warning(f'[seed-guard] portal alert failed ({reason}): {_pe}')
+    return True
