+# =====================================================================
+# Durable session_uuid -> conversation binding + money-path observability
+# (2026-07-03, ST# P1 Ashley-seed-regression fix). ALL helpers are module
+# scope so they are unit-testable without a Flask app context and reusable
+# across /api/log-conversation, /api/verify-payment, /api/send-seed.
+#
+# CONSTITUTIONAL: every lookup here is EXACT-KEY-OR-FAIL-CLOSED. There is NO
+# recency / proximity / fuzzy identity fallback anywhere in this block — that
+# is exactly the class of bug (S4 recency, S5 fuzzy-name, the SEV-1 magic-link
+# recency scan) that caused cross-customer transcript/magic-link leaks. The
+# persisted binding is keyed by the client-threaded sessionUuid ONLY; an absent
+# key returns empty (fail-closed), never another customer's data.
+# =====================================================================
+
+def _session_bindings_path():
+    return os.path.join(DEFAULT_LOG_DIR, 'session_uuid_bindings.jsonl')
+
+
+def _persist_session_binding(session_uuid, conversation, ai_name='', human_name='', human_email=''):
+    """Append a durable session_uuid -> conversation binding at naming-ceremony
+    time (called from /api/log-conversation). Idempotency-safe: an append-only
+    log; the reader (_lookup_session_binding) selects the richest EXACT-key
+    record, so repeated calls only ever improve recall (never corrupt). Only a
+    binding that actually carries naming-ceremony content is written. Returns
+    True on write, False on skip/error. Never raises."""
+    su = (session_uuid or '').strip()
+    conv = conversation or []
+    if not su:
+        return False
+    if _seed_conversation_is_empty(conv):
+        return False
+    try:
+        _rec = {
+            'session_uuid': su,
+            'ai_name': (ai_name or '').strip(),
+            'human_name': (human_name or '').strip(),
+            'human_email': (human_email or '').strip(),
+            'msg_count': len([m for m in conv if (m.get('content') or '').strip()]),
+            'conversation': conv,
+            'timestamp': datetime.now(timezone.utc).isoformat(),
+        }
+        _path = _session_bindings_path()
+        os.makedirs(os.path.dirname(_path), exist_ok=True)
+        with _file_lock:
+            with open(_path, 'a') as _f:
+                _f.write(json.dumps(_rec) + '\n')
+        return True
+    except Exception as _e:
+        logger.warning(f'[session-binding] persist failed for uuid={su}: {_e}')
+        return False
+
+
+def _lookup_session_binding(session_uuid):
+    """EXACT-KEY-ONLY hydration. Return (ai_name, conversation_list) for the
+    richest binding whose session_uuid == session_uuid EXACTLY. NO recency /
+    proximity / fuzzy match — an absent key returns ('', []) (fail-closed),
+    never another customer's binding. Never raises."""
+    su = (session_uuid or '').strip()
+    if not su:
+        return ('', [])
+    _best_ai = ''
+    _best_conv = []
+    _best_count = -1
+    try:
+        _path = _session_bindings_path()
+        if not os.path.exists(_path):
+            return ('', [])
+        with open(_path, 'r') as _f:
+            for _line in _f:
+                _line = _line.strip()
+                if not _line:
+                    continue
+                try:
+                    _rec = json.loads(_line)
+                except Exception:
+                    continue
+                # EXACT key match ONLY — the entire fail-closed contract.
+                if (_rec.get('session_uuid') or '').strip() != su:
+                    continue
+                _conv = _rec.get('conversation') or []
+                _cnt = len([m for m in _conv if (m.get('content') or '').strip()])
+                if _cnt > _best_count:
+                    _best_count = _cnt
+                    _best_conv = _conv
+                    _best_ai = (_rec.get('ai_name') or '').strip()
+    except Exception as _e:
+        logger.warning(f'[session-binding] lookup failed for uuid={su}: {_e}')
+        return ('', [])
+    return (_best_ai, _best_conv)
+
