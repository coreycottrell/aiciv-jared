+def _seed_fired_for(order_id, session_uuid):
+    """EXACT-KEY check: did a seed fire for this order_id OR session_uuid? Reads
+    the durable seed-audit stores (seed_sent_uuids.json + seed_events.jsonl).
+    Exact match only. Returns True if a seed is on record. Never raises."""
+    oid = (order_id or '').strip()
+    su = (session_uuid or '').strip()
+    try:
+        _uuids_path = os.path.join(DEFAULT_LOG_DIR, 'seed_sent_uuids.json')
+        if su and os.path.exists(_uuids_path):
+            try:
+                with open(_uuids_path) as _f:
+                    _claimed = json.load(_f)
+                _keys = _claimed.keys() if isinstance(_claimed, dict) else _claimed
+                if su in _keys:
+                    return True
+            except Exception:
+                pass
+        _events_path = os.path.join(DEFAULT_LOG_DIR, 'seed_events.jsonl')
+        if os.path.exists(_events_path):
+            with open(_events_path) as _f:
+                for _line in _f:
+                    _line = _line.strip()
+                    if not _line:
+                        continue
+                    try:
+                        _ev = json.loads(_line)
+                    except Exception:
+                        continue
+                    if (_ev.get('type') or '') not in ('seed_sent', 'seed_fired'):
+                        continue
+                    if su and (_ev.get('session_uuid') or '').strip() == su:
+                        return True
+                    if oid and (_ev.get('order_id') or '').strip() == oid:
+                        return True
+    except Exception as _e:
+        logger.warning(f'[paid-vs-seed] seed-fired check failed: {_e}')
+    return False
+
