+def _seed_deadletter_and_portal_alert(reason, portal_summary, record=None, is_sandbox=False):
+    """Mirror the empty-conversation guard mechanism EXACTLY: dead-letter to
+    logs/blocked_seeds.jsonl + raise a PORTAL alert (tmux inject to Jared's live
+    session). PORTAL not Telegram — Jared is portal-primary; a Telegram-only
+    alert is invisible to him. Sandbox requests do NOT dead-letter/alert (keeps
+    QA sandbox runs clean). Never raises. Returns True if an alert was raised."""
+    if is_sandbox:
+        return False
+    try:
+        _rec = dict(record or {})
