+  // ============================================================
+  //  STRIPE $1 ONE-TIME CARD  (Option A — clone endpoint, one-time mode)
+  //  STAGED 2026-07-03. POSTs {tier, oneTime:true, sessionUuid} to the
+  //  purebrain-awakening-clone Pages project's /api/create-checkout-session,
+  //  which server-holds the $1 amount (inline price_data, mode=payment) and
+  //  returns a client_secret. We then mount Stripe Embedded Checkout in the
+  //  modal. The clone success return_url carries &uuid= (threaded sessionUuid).
+  //  HELD: real charge path — awaits independent security pass before deploy.
+  // ============================================================
+  var PB_CLONE_ORIGIN = 'https://purebrain-awakening-clone.pages.dev';
+  var __pbStripe = null, __pbStripeCheckout = null;
+
+  function pbInjectStripeOneTime(tier, container) {
+    if (!container || document.getElementById('pb-stripe-onetime-wrap')) return;
+    var wrap = document.createElement('div');
+    wrap.id = 'pb-stripe-onetime-wrap';
+    wrap.style.marginTop = '14px';
+    wrap.innerHTML =
+      '<div style="display:flex;align-items:center;gap:8px;margin:12px 0;color:rgba(255,255,255,0.4);font-size:12px;">'
+      + '<span style="flex:1;height:1px;background:rgba(255,255,255,0.15)"></span>or<span style="flex:1;height:1px;background:rgba(255,255,255,0.15)"></span></div>'
+      + '<button id="pb-stripe-onetime-btn" type="button" style="width:100%;padding:14px;border-radius:8px;border:0;background:#635bff;color:#fff;font-size:15px;font-weight:600;cursor:pointer;">'
+      + '$1 one-time card (Stripe)</button>'
+      + '<div id="pb-stripe-onetime-mount" style="margin-top:12px;"></div>'
+      + '<div id="pb-stripe-onetime-err" style="margin-top:8px;color:#ff6b6b;font-size:13px;text-align:center;"></div>';
+    container.appendChild(wrap);
+    document.getElementById('pb-stripe-onetime-btn')
+      .addEventListener('click', function () { pbStartStripeOneTime(tier); });
+  }
+
+  function pbLoadScript(src) {
+    return new Promise(function (resolve, reject) {
+      var s = document.createElement('script');
+      s.src = src; s.onload = resolve; s.onerror = reject;
+      document.head.appendChild(s);
+    });
+  }
+
+  async function pbStartStripeOneTime(tier) {
+    var btn = document.getElementById('pb-stripe-onetime-btn');
+    var err = document.getElementById('pb-stripe-onetime-err');
+    if (err) err.textContent = '';
+    if (btn) { btn.disabled = true; btn.textContent = 'Loading secure checkout…'; }
+    try {
+      var sessionUuid = (window.crypto && crypto.randomUUID) ? crypto.randomUUID() : ('otp_' + Date.now());
+      // 1) Mint a one-time ($1) checkout session on the clone. The $1 amount is
+      //    SERVER-HELD — we send only the tier + oneTime flag, never an amount.
+      var r = await fetch(PB_CLONE_ORIGIN + '/api/create-checkout-session', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ tier: String(tier || '').toLowerCase(), oneTime: true, sessionUuid: sessionUuid })
+      });
+      var data = await r.json();
+      if (!r.ok || !data.client_secret) throw new Error((data && data.error) || 'Could not start checkout.');
+      // 2) Load Stripe.js + publishable key (served by the clone; pk is safe client-side).
+      if (!__pbStripe) {
+        await pbLoadScript('https://js.stripe.com/v3/');
+        var pkResp = await fetch(PB_CLONE_ORIGIN + '/api/stripe-pk');
+        var pkData = await pkResp.json();
+        if (!pkData || !pkData.pk) throw new Error('Missing publishable key.');
+        __pbStripe = window.Stripe(pkData.pk);
+      }
+      // 3) Mount Stripe Embedded Checkout (embedded_page rail pairs with initEmbeddedCheckout).
+      if (__pbStripeCheckout) { try { __pbStripeCheckout.destroy(); } catch (e) {} }
+      __pbStripeCheckout = await __pbStripe.initEmbeddedCheckout({ clientSecret: data.client_secret });
+      if (btn) btn.style.display = 'none';
+      __pbStripeCheckout.mount('#pb-stripe-onetime-mount');
+    } catch (e) {
+      if (err) err.textContent = (e && e.message) ? e.message : 'Checkout failed.';
+      if (btn) { btn.disabled = false; btn.textContent = '$1 one-time card (Stripe)'; }
+    }
+  }
+
